DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/historias_medicas
JWT_SECRET=cambia-este-secreto-en-produccion
APP_ORIGIN=http://localhost:5173
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
PGSSLMODE=disable
LOG_LEVEL=info

# Desarrollo local: local usa Fastify/PostgreSQL; firebase usa Auth + Data Connect.
# Para App Hosting usa .env.production.example y los valores de compilación en apphosting.yaml.
VITE_DATA_BACKEND=local

# Configuración web de Firebase (Project settings > Your apps > Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional para desarrollo con emuladores.
VITE_FIREBASE_USE_EMULATORS=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_DATA_CONNECT_EMULATOR_PORT=9399
