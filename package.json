{
  "name": "historias-medicas-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"vite\" \"node --watch server/index.mjs\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node server/static.mjs",
    "seed": "node server/seed.mjs",
    "migrate:legacy": "node server/migrate-legacy.mjs",
    "firebase:compile": "firebase dataconnect:compile --service studio-9955473018-e374d-service --location us-east4",
    "firebase:sdk": "firebase dataconnect:sdk:generate --service studio-9955473018-e374d-service --location us-east4 --non-interactive"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/static": "^8.0.4",
    "@google-cloud/cloud-sql-connector": "^1.12.1",
    "@historias/dataconnect": "file:src/services/firebase/dataconnect",
    "@tanstack/react-query": "^5.90.0",
    "fastify": "^5.6.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.13.1",
    "pg-copy-streams": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "serve": "^14.2.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.1"
  }
}
